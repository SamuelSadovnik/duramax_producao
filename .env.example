# Conexão com o Postgres.
# Local (docker compose):  postgres://duramax:duramax@localhost:5432/duramax_producao
# Produção (Neon): use a connection string "pooled" do painel do Neon, com ?sslmode=require
DATABASE_URL=postgres://duramax:duramax@localhost:5432/duramax_producao

# Segredo para assinar as sessões de login. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=troque-por-um-valor-aleatorio-bem-longo

# Porta da API no desenvolvimento local
PORT=3001
